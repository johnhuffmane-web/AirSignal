<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.universalir">

    <!-- REQUIRED: Permission to use the phone's built-in infrared emitter -->
    <uses-permission android:name="android.permission.TRANSMIT_IR" />
    
    <!-- REQUIRED: Ensures Google Play only lets phones with IR hardware download your app -->
    <uses-feature android:name="android.hardware.consumerir" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Universal IR"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight">
        
        <!-- Main Dashboard Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dynamic Control Screen Activity -->
        <activity
            android:name=".ControlActivity"
            android:exported="false" />

    </application>

</manifest>